        <attribute name="label" translatable="yes">画像をあぼ〜んする(_B)</attribute>
        <attribute name="action">image.AboneImage</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">プロパティ(_P)...</attribute>
        <attribute name="action">image.Preference</attribute>
      </item>
    </section>
  </menu>
</interface>
